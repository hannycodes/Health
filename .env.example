# ---------------------------------------------------------------------------
# MyHealth frontend environment configuration
# Copy to `.env.local` and adjust as needed. Only VITE_* values are exposed to
# the browser bundle — never put secrets here.
# ---------------------------------------------------------------------------

# Base URL of the backend API (FastAPI service owned by the backend team).
VITE_API_BASE_URL=http://localhost:8000/api

# Which service layer the UI should use: "mock" (default) or "http".
# "http" is a placeholder adapter that targets VITE_API_BASE_URL.
VITE_DATA_SOURCE=mock

# --- Medical AI assistant (server-side only) -------------------------------
# Read by the local API in server/api.ts. Never prefix these with VITE_:
# that would ship the provider key to every browser.
# The assistant answers in the patient language (English or Amharic) and reads
# photos, so a vision-capable model is required.
ZAI_API_KEY=
ZAI_API_BASE=https://api.z.ai/api/paas/v4
ZAI_MODEL=glm-4.6v-flash
# How long to wait for the model before returning a plain timeout message.
AI_TIMEOUT_MS=90000
