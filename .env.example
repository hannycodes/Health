# ---------------------------------------------------------------------------
# MyHealth frontend environment configuration
# Copy to `.env.local` and adjust as needed. Only VITE_* values are exposed to
# the browser bundle — never put secrets here.
# ---------------------------------------------------------------------------

# Base URL of the backend API (FastAPI service owned by the backend team).
VITE_API_BASE_URL=http://localhost:8000/api

# Which service layer the UI should use: "mock" (default) or "http".
# "http" is a placeholder adapter that targets VITE_API_BASE_URL.
VITE_DATA_SOURCE=mock

# Maximum size (MB) of an image attached to an AI Health Assistant message.
# The browser validates against this limit; the backend enforces its own.
VITE_AI_IMAGE_MAX_MB=5
