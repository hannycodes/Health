# ---------------------------------------------------------------------------
# MyHealth frontend environment
# Copy to `.env.local`. Only VITE_* values reach the browser bundle.
# ---------------------------------------------------------------------------

# Base URL of the API. `/api` uses the Vite dev proxy to the Node server.
VITE_API_BASE_URL=/api

# Service layer: "http" (Node API in server/) or "mock" (tests only).
VITE_DATA_SOURCE=http

# Maximum size (MB) of an image attached to an AI Assistant message.
VITE_AI_IMAGE_MAX_MB=5

# ---------------------------------------------------------------------------
# Backend (server/index.mjs) — loaded with `npm run api`, never sent to the
# browser. Use a dedicated medical AI provider key.
# ---------------------------------------------------------------------------
# ZAI_API_KEY=your_key_here
# ZAI_API_BASE=https://api.z.ai/api/paas/v4
# ZAI_MODEL=glm-4v-flash
# SEED_PASSWORD=MyHealth2026!
