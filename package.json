{
  "name": "myhealth-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:ai": "node --env-file-if-exists=.env --env-file-if-exists=.env.local server/index.mjs",
    "verify:ai": "node --env-file-if-exists=.env --env-file-if-exists=.env.local server/verify.mjs",
    "build": "tsc --noEmit && vite build",
