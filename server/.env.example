# Copy to .env and adjust for your machine. The server reads these at startup.

PORT=8000

# Sign JWTs with a long random value before deploying anywhere public.
JWT_SECRET=replace-me-with-a-long-random-string
JWT_EXPIRES_IN=12h

# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGIN=http://localhost:5173

# Where the JSON data file lives. Defaults to server/data.
# DATA_DIR=./data

# Password given to every seeded demo account.
DEV_SEED_PASSWORD=Password123!
